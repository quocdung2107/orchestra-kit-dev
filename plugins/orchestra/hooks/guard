#!/usr/bin/env python
"""Hook PreToolUse: guard theo trạng thái task (v0.2 N1). Phase 3: SHADOW — luôn cho qua, chỉ ghi
`.orchestra/runtime/guard-shadow.jsonl`. No-op nếu không có .orchestra/.

Chế độ thật (Phase 4) sẽ chặn bằng exit 2 và fail-closed khi lỗi; khi đó lối thoát là ORC_SAFE_MODE=1
(chỉ sửa kit + cấu hình orchestra), không có lối tắt tắt guard.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    raw = ""
    try:
        raw = sys.stdin.buffer.read().decode("utf-8")
        payload = json.loads(raw or "{}")
        import orc_guard  # chỉ stdlib
        orc_guard.shadow(payload)
    except Exception as exc:  # shadow: không bao giờ làm hỏng phiên
        print(f"[orchestra] guard shadow lỗi: {exc}", file=sys.stderr)
        try:  # ghi lỗi để báo cáo shadow đếm được (không bao giờ làm hỏng phiên)
            import datetime, os
            d = os.path.join(json.loads(raw or "{}").get("cwd") or ".", ".orchestra", "runtime")
            if os.path.isdir(d):
                with open(os.path.join(d, "hook-errors.jsonl"), "a", encoding="utf-8") as f:
                    f.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                                        "hook": "guard", "error": str(exc)[:300]}, ensure_ascii=False) + "\n")
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
