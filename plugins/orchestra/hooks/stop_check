#!/usr/bin/env python
"""Hook Stop: chặn kết thúc khi phiên đã mở S-ID mà handoff chưa hợp lệ.

Tương đương `orc validate --handoff --key <session_id>`. No-op nếu không có
.orchestra/ hoặc phiên chưa mở S-ID (Dung chốt Q4, 2026-10-05).
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except Exception:
        return 0
    try:
        import orc_core
        if orc_core.legacy_hook_shadowed(data.get("cwd") or "."):
            return 0  # cầu nối rc-k-3: dự án đã bật plugin orchestra, plugin tự chạy hook
        root = orc_core.find_root(data.get("cwd") or ".")
        if root is None:
            return 0
        decision = orc_core.stop_check(root, data.get("session_id"))
    except Exception as exc:  # lỗi của kit không được khoá phiên
        print(f"[orchestra] stop_check lỗi, bỏ qua: {exc}", file=sys.stderr)
        return 0
    if decision:
        print(json.dumps(decision, ensure_ascii=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
