#!/usr/bin/env python
"""Hook SessionStart: nạp `orc brief` vào ngữ cảnh. No-op nếu không có .orchestra/."""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except Exception:
        data = {}
    try:
        import orc_core  # chỉ stdlib ở cấp module; PyYAML nạp muộn
        root = orc_core.find_root(data.get("cwd") or ".")
        if root is None:
            return 0
        text = orc_core.brief_text(root, key=data.get("session_id"))
    except Exception as exc:  # không bao giờ làm hỏng phiên
        text = f"[orchestra] Không tạo được brief: {exc}"
    # ensure_ascii: tránh lỗi mã hoá tiếng Việt trên console Windows
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                             "additionalContext": text}}, ensure_ascii=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
