#!/usr/bin/env python
"""Hook UserPromptSubmit: ghi bằng chứng lời Dung vào `.orchestra/runtime/prompts.jsonl` (v0.2 N2, W2.4).

Mỗi lời: ts, session_id, sha256 toàn văn, và nguyên văn chỉ các dòng `orc:<lệnh> ...` (orc:approve, orc:resume,
orc:downgrade). Chuỗi hash `prev` để phát hiện sửa/xoá dòng cũ. Không chặn; no-op nếu không có .orchestra/.
Giới hạn: process cùng user vẫn ghi thêm được dòng hợp lệ vào file này — chuỗi hash phát hiện sửa, không ngăn thêm.
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "cli"))


def main() -> int:
    raw = ""
    try:
        raw = sys.stdin.buffer.read().decode("utf-8")
        payload = json.loads(raw or "{}")
        import orc_guard  # chỉ stdlib
        orc_guard.log_prompt(payload)
    except Exception as exc:  # không bao giờ làm hỏng phiên
        print(f"[orchestra] prompt_log lỗi: {exc}", file=sys.stderr)
        try:  # ghi lỗi để báo cáo shadow đếm được (không bao giờ làm hỏng phiên)
            import datetime, os
            d = os.path.join(json.loads(raw or "{}").get("cwd") or ".", ".orchestra", "runtime")
            if os.path.isdir(d):
                with open(os.path.join(d, "hook-errors.jsonl"), "a", encoding="utf-8") as f:
                    f.write(json.dumps({"ts": datetime.datetime.now().isoformat(timespec="seconds"),
                                        "hook": "prompt_log", "error": str(exc)[:300]}, ensure_ascii=False) + "\n")
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
